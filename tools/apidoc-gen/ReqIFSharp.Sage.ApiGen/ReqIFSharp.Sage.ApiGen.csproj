<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <!-- Copy ReqIFSharp.xml / ReqIFSharp.Extensions.xml (shipped next to the assemblies in the packages'
         lib/netstandard2.0) into the output, so the generator can read the XML documentation at run time. -->
    <CopyDocumentationFilesFromPackages>true</CopyDocumentationFilesFromPackages>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="ReqIFSharp" />
    <PackageReference Include="ReqIFSharp.Extensions" />
  </ItemGroup>

</Project>
